<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas sin paquetes externos: es un ejecutable que devuelve código de salida distinto de 0 si algo falla. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Asclepio.Pruebas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Asclepio.Core\Asclepio.Core.csproj" />
  </ItemGroup>

</Project>
